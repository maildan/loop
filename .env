# 🔥 Loop 개발 환경변수 설정


# 🔥 기본 환경 설정
# NODE_ENV는 package.json 스크립트에서 설정됨
# - pnpm dev: NODE_ENV=development (자동)
# - pnpm start: NODE_ENV=production (cross-env)
# NODE_ENV=development  # ❌ 제거: package.json의 cross-env와 충돌

# 🔥 포트 설정 (환경별 분리)
# 개발 환경: Vite dev server (기본 5173)
PORT=35821
ELECTRON_PORT=35821
RENDERER_PORT=35821

# 프로덕션 환경: StaticServer 포트
STATIC_SERVER_ORIGIN=35821

# 🔥 URL 설정 (환경별 분리)
# 개발 환경: Vite dev server - 포트 통일
ELECTRON_RENDERER_URL=http://localhost:35821
VITE_DEV_SERVER_URL=http://localhost:35821

# 프로덕션 환경: StaticServer
# STATIC_SERVER_ORIGIN에 포트(예: 35821)를 설정했습니다
STATIC_SERVER_URL=http://localhost:35821
NEXT_PUBLIC_SHARE_WEB_URL=https://eloop.kro.kr
NEXT_PUBLIC_SHARE_API_URL=https://api.eloop.kro.kr

# 🔥 Logger 설정 - DEBUG 레벨 강제 활성화
LOG_LEVEL=debug
DEBUG=true
VERBOSE_LOGGING=true

# 🔥 데이터베이스 설정
# DATABASE_URL is automatically set at runtime by ensureDatabaseUrl()
# OS별 동적 경로: Windows/Mac/Linux 모두 app.getPath('userData') 사용
# See: src/main/utils/prismaPaths.ts
# ⚠️ Prisma CLI migration용 임시 설정 (개발 환경 전용)
DATABASE_URL="file:loop.db" 



# 🔥 성능 모니터링
ENABLE_PERFORMANCE_TRACKING=true
MEMORY_MONITORING=true

# 🔥 키보드 모니터링 설정
KEYBOARD_MONITORING_ENABLED=true
KEYBOARD_DEBUG_MODE=true

# 🔥 AI/분석 기능 (개발용)
AI_ANALYSIS_ENABLED=true
MOCK_AI_RESPONSES=true

# 🔥 개발자 도구
REACT_DEVELOPER_TOOLS=true
REDUX_DEVTOOLS=true

# 🔥 Google OAuth 설정 (범용 리다이렉트 URI)
GOOGLE_CLIENT_ID=1031693860284-t17pn2osrbeaqllmhhlru92km35t652v.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_API_KEY=AIzaSyBMVJIOQT-WcnpGY31tMPdhOBsUAFhD_7U
GOOGLE_REDIRECT_URI=http://localhost:35821/oauth/callback

# 🔥 암호화 키
ENCRYPT_SNAPSHOT_KEY=2cfe31bb63d49c469621fc884493d45cb548bb78d2d4b9c6b3dc66bc467befca

# 🔥 Gemini AI 설정
GEMINI_API_KEY=AIzaSyBMVJIOQT-WcnpGY31tMPdhOBsUAFhD_7U
