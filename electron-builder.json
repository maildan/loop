{
  "productName": "Loop",
  "appId": "com.loop.app",
  "compression": "maximum",
  "protocols": [
    {
      "name": "Loop App",
      "schemes": [
        "com.loop.app",
        "loop"
      ]
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "out/main/**/*",
    "out/preload/**/*",
    "out/renderer/**/*",
    "assets/**/*",
    "package.json",
    "!node_modules/pretendard-jp/**",
    "!node_modules/pretendard/**",
    "!node_modules/**/*.md",
    "!node_modules/**/*.ts",
    "!node_modules/**/LICENSE*",
    "!node_modules/**/README*",
    "!node_modules/**/*.map",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/*.node",
    "**/*.dll",
    "**/*.dylib",
    "**/*.so",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/**/*",
    "node_modules/.bin/prisma*"
  ],
  "extraResources": [
    {
      "from": "prisma/schema.prisma",
      "to": "prisma/schema.prisma"
    },
    {
      "from": "prisma/loop.db",
      "to": "prisma/loop.db"
    }
  ],
  "extraFiles": [],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "public/assets/icon.icns",
    "entitlements": "public/assets/entitlements.mac.plist",
    "entitlementsInherit": "public/assets/entitlements.mac.plist",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "asar": true,
    "files": [
      "node_modules/node-mac-permissions/**"
    ],
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "dmg": {
    "background": null,
    "sign": false,
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 130,
        "y": 190,
        "type": "file"
      },
      {
        "x": 410,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "win": {
    "icon": "public/assets/icon.png",
    "target": [
      {
        "target": "nsis-web",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "files": [
      "!node_modules/node-mac-permissions/**"
    ]
  },
  "linux": {
    "icon": "public/assets/icon.png",
    "category": "Utility",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Loop",
    "differentialPackage": true,
    "installerIcon": "public/assets/icon.png",
    "uninstallerIcon": "public/assets/icon.png",
    "license": null,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "nsisWeb": {
    "artifactName": "${productName} Web Setup ${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "maildan",
    "repo": "loop",
    "releaseType": "release"
  },
  "asar": true
}